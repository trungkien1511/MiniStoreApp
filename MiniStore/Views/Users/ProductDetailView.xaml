<Page x:Class="MiniStore.Views.User.ProductDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Chi tiết sản phẩm">

    <Grid Margin="20" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== CỘT 1: ẢNH SẢN PHẨM ===== -->
        <StackPanel Grid.Column="0" Margin="10">
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                <Image x:Name="ProductImage"
                       Source="{Binding ProductImage}"
                       Stretch="Uniform"
                       Height="300"/>
            </Border>

            <!-- Ảnh nhỏ (thumbnails) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Border BorderBrush="Red" BorderThickness="2" CornerRadius="5" Margin="5">
                    <Image Width="60" Height="60" Stretch="Uniform"/>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5">
                    <Image Width="60" Height="60" Stretch="Uniform"/>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="5">
                    <Image Width="60" Height="60" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ===== CỘT 2: THÔNG TIN ===== -->
        <StackPanel Grid.Column="1" Margin="20,10">
            <!-- Tên sản phẩm -->
            <TextBlock Text="{Binding ProductName}"
                       FontSize="20" FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Giá -->
            <TextBlock Text="{Binding ProductPrice}"
                       FontSize="16"
                       Foreground="Red"
                       FontWeight="Bold"/>

            <!-- Tình trạng -->
            <TextBlock Text="{Binding ProductName}"
                       FontSize="15"
                       Foreground="Green"
                       Margin="0,0,0,20"/>

            <!-- Vận chuyển -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Miễn phí giao hàng cho đơn từ 300.000đ." FontSize="14"/>
                <TextBlock Text="Giao hàng trong 2 giờ." FontSize="14"/>
            </StackPanel>

            <!-- Chọn số lượng -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,20">
                <Button x:Name="BtnMinus" Content="-" Width="30" Height="30" Command="{Binding DecreaseQuantityCommand}"/>
                <TextBlock x:Name="TxtQuantity"
                           Text="1"
                           Width="30"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"/>
                <Button x:Name="BtnPlus" Content="+" Width="30" Height="30" Command="{Binding IncreaseQuantityCommand}"/>
            </StackPanel>

            <!-- Nút thêm giỏ -->
            <Button x:Name="btnCart"
                    Content="🛒 THÊM VÀO GIỎ"
                    Style="{StaticResource RedButton}"
                    Height="45"
                    Width="200"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Left"
                    Margin="10 0"
                    Command="{Binding AddToCartCommand}"/>
        </StackPanel>
    </Grid>
</Page>
