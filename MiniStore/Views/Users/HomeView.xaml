<Page x:Class="MiniStore.Views.User.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Page.Resources>
        <!-- CardButton style -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        BorderBrush="Transparent"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover mượt: viền đỏ + background nhẹ -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="Red" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FFF5F5F5" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="Transparent" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="CardBorder"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="White" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

       
        <!-- Product Card Template -->
        <DataTemplate x:Key="ProductCardTemplate">
            <Button Style="{StaticResource CardButton}" 
                Margin="10" Width="250" Height="400"
                Command="{Binding DataContext.ViewProductDetailCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                CommandParameter="{Binding}">
                <Button.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Button.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <!-- Ảnh cố định -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tên sản phẩm -->
                        <RowDefinition Height="Auto"/>
                        <!-- Giá -->
                        <RowDefinition Height="*"/>
                        <!-- Nút thêm giỏ (fill phần còn lại) -->
                    </Grid.RowDefinitions>

                    <!-- Ảnh sản phẩm -->
                    <Border Background="#F9F9F9" CornerRadius="8" Margin="0,0,0,30" Grid.Row="0">
                        <Image Source="{Binding ImagePath}" Width="200"/>
                    </Border>

                    <!-- Tên sản phẩm -->
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,0,0,8"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Grid.Row="1"/>

                    <!-- Giá sản phẩm -->
                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} đ}" 
                   Foreground="Red" FontWeight="SemiBold" FontSize="14"
                   HorizontalAlignment="Center" Margin="0,0,0,50" Grid.Row="2"/>

                    <!-- Nút thêm vào giỏ -->
                    <Button Style="{StaticResource RedButton}"
                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}" Grid.Row="3">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Thêm vào giỏ" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Button>
        </DataTemplate>

    </Page.Resources>

    <ItemsControl ItemsSource="{Binding Products}"
              ItemTemplate="{StaticResource ProductCardTemplate}"
              HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>

</Page>
